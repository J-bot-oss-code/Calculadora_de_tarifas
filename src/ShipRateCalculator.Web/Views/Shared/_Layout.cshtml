        </div>
        <div class="plane plane-3 plane-cyan">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M22 16.5v-2l-8.5-5V3.5c0-.83-.67-1.5-1.5-1.5s-1.5.67-1.5 1.5v6l-8.5 5v2l8.5-2.5V19l-2.5 1.5V22l4-1 4 1v-1.5L13.5 19v-5.5l8.5 3z" /></svg>
        </div>
        <div class="plane plane-4 plane-violet">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M22 16.5v-2l-8.5-5V3.5c0-.83-.67-1.5-1.5-1.5s-1.5.67-1.5 1.5v6l-8.5 5v2l8.5-2.5V19l-2.5 1.5V22l4-1 4 1v-1.5L13.5 19v-5.5l8.5 3z" /></svg>
        </div>
        <div class="plane plane-5 plane-cyan">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M22 16.5v-2l-8.5-5V3.5c0-.83-.67-1.5-1.5-1.5s-1.5.67-1.5 1.5v6l-8.5 5v2l8.5-2.5V19l-2.5 1.5V22l4-1 4 1v-1.5L13.5 19v-5.5l8.5 3z" /></svg>
        </div>
    </div>
    <div class="sr-page">
        <div class="brand-row">
            <div class="brand-mark">SR</div>
            <div class="brand-text">
                <h1>SHIPRATE</h1>
                <p>// calculadora de tarifas internacionales</p>
            </div>
        </div>
        @RenderBody()
        <div class="footnote">TARIFAS DE REFERENCIA &middot; SUJETAS A REGLAS DE NEGOCIO VIGENTES</div>
    </div>
</body>
</html>